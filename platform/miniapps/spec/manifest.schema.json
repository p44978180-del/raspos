{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timacad.local/miniapps/manifest.schema.json",
  "title": "TIM mini-app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "bundle_sha256", "signature", "csp", "host_methods"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 80, "maxLength": 120},
    "csp": {"type": "string", "minLength": 1, "maxLength": 512},
    "host_methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "host.v1.schedule.read",
          "host.v1.group.read",
          "host.v1.navigate.building",
          "host.v1.thread.read",
          "host.v1.storage.kv",
          "host.v1.duty_roster.write"
        ]
      }
    },
    "wasm_component_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {"enum": ["nfc", "biometrics", "wallet"]}
      }
    }
  }
}
