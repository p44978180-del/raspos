# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text file formats
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.rs text eol=lf
*.go text eol=lf
*.swift text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Direct binary storage (native Git blobs without Git LFS)
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.apk binary
*.keystore binary
*.jks binary

# GitHub Linguist: Exclude vendored assets, large JSON datasets, and binary caches
public/vendor/** linguist-vendored=true
public/data/** linguist-vendored=true
src/data/** linguist-vendored=true
downloads/** linguist-vendored=true
cache_pdfs/** linguist-vendored=true
scripts/pdf* linguist-vendored=true
scripts/*.txt linguist-documentation=true
sample_schedule.pdf linguist-vendored=true
*.json linguist-generated=true
*.pdf linguist-vendored=true
*.zip linguist-vendored=true
*.apk linguist-vendored=true
*.png linguist-vendored=true
*.ico linguist-vendored=true

# GitHub Linguist: Ensure high visibility for Kotlin, Rust, Go, Swift
*.kt linguist-detectable=true
*.kts linguist-detectable=true
*.rs linguist-detectable=true
*.go linguist-detectable=true
*.swift linguist-detectable=true